# 32+ random characters; signs the login cookie. Generate: openssl rand -base64 32
NUXT_SESSION_PASSWORD=

# Postgres (Neon / Vercel Postgres / Supabase). Empty in local dev → embedded PGlite in .data/db
NUXT_DATABASE_URL=

# First admin — created automatically while the users table is empty
NUXT_ADMIN_LOGIN=admin
NUXT_ADMIN_PASSWORD=

# GA4 Data API (service account with Viewer access to the property)
NUXT_GA4_PROPERTY_ID=
NUXT_GA4_CLIENT_EMAIL=
# Paste the private_key from the JSON key; "\n" sequences are accepted
NUXT_GA4_PRIVATE_KEY=
NUXT_GA4_LEAD_EVENT=click
NUXT_GA4_CACHE_TTL=600

# 1 → demo numbers instead of GA4 (local development only)
NUXT_GA4_MOCK=

# Telegram alerts: token from @BotFather, and the chat id (add the bot to the chat first)
NUXT_TELEGRAM_BOT_TOKEN=
NUXT_TELEGRAM_CHAT_ID=
# Protects /api/cron/alerts; Vercel Cron sends it automatically as a Bearer token
CRON_SECRET=
# Public address, used for links in Telegram messages
NUXT_PUBLIC_URL=https://dashboard-xi-ten-54.vercel.app
